# Copy to .env (git-ignored) for local development.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# Leave empty locally to use SQLite (backend/db.sqlite3).
# Production: the Neon connection string, e.g.
# postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Which photographer the public home page shows.
DEFAULT_PHOTOGRAPHER_SLUG=ziyue

# Leave R2_ACCOUNT_ID empty locally to store files under backend/media/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional limits
# MAX_PHOTO_UPLOAD_MB=40
# MAX_VIDEO_UPLOAD_MB=30
# MAX_PHOTO_MEGAPIXELS=80
